# Reference PSF: Alucone XPS 30nm resist
# Modern inorganic resist (aluminum alkoxide) for comparison
# Usage: ./ebl_sim ref_alucone_30nm.mac
#
# NOTE: Detector settings MUST come before /run/initialize so the geometry
# is built with the requested thickness and the physics cuts match the material.

/run/verbose 1
/event/verbose 0
/tracking/verbose 0

# Alucone (from XPS): AlC5H4O2 at 1.35 g/cm³
/det/setResistComposition "Al:1,C:5,H:4,O:2"
/det/setResistThickness 30 nm
/det/setResistDensity 1.35 g/cm3

# Initialize (geometry built once with correct material and thickness)
/run/initialize

# Enable physics processes
/process/em/fluo 1
/process/em/auger 1

# 100 keV point source: beam blur is applied separately by BEAMER,
# so the PSF must be generated with beamSize 0.
/gun/particle e-
/gun/energy 100 keV
/gun/direction 0 0 -1
/gun/beamSize 0 nm

# 300k events: good statistics at reasonable runtime (use 1M for production references)
/run/beamOn 300000
