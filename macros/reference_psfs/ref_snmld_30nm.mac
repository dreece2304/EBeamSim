# Reference PSF: Sn-MLD (Tincone) 30nm resist
# High-Z tin-containing resist for comparison
# Usage: ./ebl_sim ref_snmld_30nm.mac
#
# NOTE: Detector settings MUST come before /run/initialize so the geometry
# is built with the requested thickness and the high-Z physics (0.01nm cuts,
# Mott correction) is applied for Sn.

/run/verbose 1
/event/verbose 0
/tracking/verbose 0

# Sn-MLD (Tin oxo-cage MLD): SnC8H8O4 at 2.0 g/cm³
/det/setResistComposition "Sn:1,C:8,H:8,O:4"
/det/setResistThickness 30 nm
/det/setResistDensity 2.0 g/cm3

# Initialize (geometry built once with correct material and thickness)
/run/initialize

# Enable physics processes for high-Z
/process/em/fluo 1
/process/em/auger 1

# 100 keV point source: beam blur is applied separately by BEAMER,
# so the PSF must be generated with beamSize 0.
/gun/particle e-
/gun/energy 100 keV
/gun/direction 0 0 -1
/gun/beamSize 0 nm

# 300k events: good statistics at reasonable runtime (use 1M for production references)
/run/beamOn 300000
