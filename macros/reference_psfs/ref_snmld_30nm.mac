# Reference PSF: Sn-MLD (Tincone) 30nm resist
# High-Z tin-containing resist for comparison
# Usage: ./ebl_sim ref_snmld_30nm.mac

/run/verbose 1
/event/verbose 0
/tracking/verbose 0

# Initialize
/run/initialize

# Sn-MLD (Tin oxo-cage MLD): SnC8H8O4 at 2.0 g/cm³
/det/setResistComposition "Sn:1,C:8,H:8,O:4"
/det/setResistThickness 30 nm
/det/setResistDensity 2.0 g/cm3
/det/update

# Enable physics processes for high-Z
/process/em/fluo 1
/process/em/auger 1

# Standard 100 keV beam with small beam size for PSF
/gun/particle e-
/gun/energy 100 keV
/gun/position 0 0 100 nm
/gun/direction 0 0 -1
/gun/beamSize 2 nm

# 1M events for excellent statistics on reference PSF (high-Z needs more)
/run/beamOn 1000000
