# Reference PSF: PMMA 100nm resist
# Standard traditional negative-tone resist for comparison
# Usage: ./ebl_sim ref_pmma_100nm.mac

/run/verbose 1
/event/verbose 0
/tracking/verbose 0

# Initialize
/run/initialize

# PMMA: C5H8O2 at 1.19 g/cm³
/det/setResistComposition "C:5,H:8,O:2"
/det/setResistThickness 100 nm
/det/setResistDensity 1.19 g/cm3
/det/update

# Enable physics processes
/process/em/fluo 1
/process/em/auger 1

# Standard 100 keV beam with small beam size for PSF
/gun/particle e-
/gun/energy 100 keV
/gun/position 0 0 200 nm
/gun/direction 0 0 -1
/gun/beamSize 2 nm

# 200k events for good statistics on reference PSF
/run/beamOn 200000
