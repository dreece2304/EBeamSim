# Reference PSF: HSQ 100nm resist
# Standard traditional negative-tone resist for comparison
# Usage: ./ebl_sim ref_hsq_100nm.mac

/run/verbose 1
/event/verbose 0
/tracking/verbose 0

# Initialize
/run/initialize

# HSQ (Hydrogen Silsesquioxane): SiH1O1.5 at 1.40 g/cm³
/det/setResistComposition "Si:1,H:1,O:1.5"
/det/setResistThickness 100 nm
/det/setResistDensity 1.40 g/cm3
/det/update

# Enable physics processes
/process/em/fluo 1
/process/em/auger 1

# Standard 100 keV beam with small beam size for PSF
/gun/particle e-
/gun/energy 100 keV
/gun/position 0 0 200 nm
/gun/direction 0 0 -1
/gun/beamSize 2 nm

# 1M events for excellent statistics on reference PSF
/run/beamOn 1000000
