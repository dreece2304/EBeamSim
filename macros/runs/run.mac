# Standard run macro for batch mode PSF generation
# Usage: ./ebl_sim run.mac
#
# NOTE: Detector settings MUST come before /run/initialize so the geometry
# is built with the requested thickness and the physics cuts match the material.

# Verbose settings
/run/verbose 1
/event/verbose 0
/tracking/verbose 0

# Set resist properties (Alucone from XPS)
/det/setResistComposition "Al:1,C:5,H:4,O:2"
/det/setResistThickness 30 nm
/det/setResistDensity 1.35 g/cm3

# Initialize geometry and physics
/run/initialize

# Enable physics processes
/process/em/fluo 1
/process/em/auger 1

# Configure beam - point source (0 nm): BEAMER applies beam blur separately,
# so the PSF must be generated with beamSize 0.
/gun/particle e-
/gun/energy 100 keV
/gun/direction 0 0 -1
/gun/beamSize 0 nm

# Run simulation
# 100k events gives good statistics for PSF
/run/beamOn 100000

# Output files will be saved in the current working directory:
# - ebl_psf_data.csv (radius, energy density for general analysis)
# - beamer_psf.dat (for BEAMER software; radius in um, peak-normalized)
# - simulation_summary.txt
