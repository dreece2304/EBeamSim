# Macro to export trajectory data for visualization
# Usage: ./ebl_sim -m macros/trajectory_export.mac

# ============================================================
# GEOMETRY SETUP
# ============================================================
/det/setResistComposition Zn:1,C:2,H:4,O:2
/det/setResistDensity 2.1 g/cm3
/det/setResistThickness 100 nm

# Initialize geometry
/run/initialize

# ============================================================
# BEAM CONFIGURATION
# ============================================================
/gun/particle e-
/gun/energy 100 keV
/gun/position 0 0 150 nm
/gun/direction 0 0 -1
/gun/beamSize 0 nm

# ============================================================
# ENABLE TRAJECTORY RECORDING
# ============================================================
/ebl/trajectory/setFile trajectories.json
/ebl/trajectory/enable true

# ============================================================
# RUN SIMULATION
# ============================================================
/run/beamOn 10

# ============================================================
# WRITE TRAJECTORY DATA
# ============================================================
/ebl/trajectory/write
