# Macro to export EUV-induced electron trajectories for visualization
# EUV lithography: 13.5nm wavelength = 92 eV photons
# Usage: ./ebl_sim -m macros/trajectory_euv.mac

# ============================================================
# GEOMETRY SETUP
# ============================================================
/det/setResistComposition Zn:1,C:2,H:4,O:2
/det/setResistDensity 2.1 g/cm3
/det/setResistThickness 100 nm

# Initialize geometry
/run/initialize

# ============================================================
# EUV BEAM CONFIGURATION
# 13.5 nm wavelength = 91.8 eV photon energy
# ============================================================
/gun/particle gamma
/gun/energy 92 eV
/gun/position 0 0 150 nm
/gun/direction 0 0 -1
/gun/beamSize 0 nm

# ============================================================
# ENABLE TRAJECTORY RECORDING
# ============================================================
/ebl/trajectory/setFile trajectories_euv.json
/ebl/trajectory/enable true

# ============================================================
# RUN SIMULATION (more events needed - lower absorption cross-section)
# ============================================================
/run/beamOn 100

# ============================================================
# WRITE TRAJECTORY DATA
# ============================================================
/ebl/trajectory/write
